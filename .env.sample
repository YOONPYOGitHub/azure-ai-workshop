# 워크숍 Azure OpenAI 프록시로 사용할 공개 APIM 게이트웨이 URL입니다.
AZURE_OPENAI_ENDPOINT=https://apim-ai-workshop-010.azure-api.net/

# 수강생에게 배포할 APIM 구독 키입니다. AOAI 리소스 키를 사용하지 마세요.
AZURE_OPENAI_KEY=YOUR_APIM_SUBSCRIPTION_KEY

# 워크숍 노트북에서 기본으로 사용할 Azure OpenAI API 버전입니다.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# 기본 Chat Completions 호출에 사용할 배포 이름입니다.
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.4-mini

# 더 작고 비용이 낮은 모델을 명시적으로 사용하는 예제용 배포 이름입니다.
AZURE_OPENAI_NANO_DEPLOYMENT_NAME=gpt-5.4-nano

# text-embedding-3-large 임베딩 배포 이름과 벡터 차원입니다.
EMBEDDING_MODEL_NAME=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

# 웹 검색 예제용 SerpAPI 키입니다. 사용하지 않으면 xxx로 두세요.
SERP_API_KEY=xxx

